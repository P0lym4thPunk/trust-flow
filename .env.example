# ==========================================
# TrustFlow Environment Configuration
# ==========================================

# Server-Side Secrets (Never expose to client or frontend bundles)
GEMINI_API_KEY=
PORT=3000
NODE_ENV=development

# Stellar Network Configuration
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Frontend Public Configuration (Vite client-side)
VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Privy / External Authentication Configuration
# Obtain your App ID from https://dashboard.privy.io (Public Client ID)
VITE_PRIVY_APP_ID=
# If server-side session verification or webhooks are used:
# PRIVY_APP_SECRET= (Backend secret only - NEVER put in VITE_*)