# Server & Network
PORT=3000
NODE_ENV=development
DATA_DIR=.data
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Runtime AI (Gemini 3.8 Flash - server-side only, never expose to VITE_*)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=6000
AI_MAX_INPUT_CHARS=2000
AI_MAX_OUTPUT_TOKENS=1024
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000

# Authentication & Wallet Providers (server-side verification)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
VITE_PRIVY_APP_ID=

# Email OTP Delivery (returns 503 if no provider configured)
OTP_SECRET=
OTP_TTL_MS=600000
OTP_MAX_ATTEMPTS=5
EMAIL_OTP_WEBHOOK_URL=

# Development Sandbox (strictly disabled when NODE_ENV=production)
ALLOW_DEV_SANDBOX=true
VITE_ALLOW_DEV_SANDBOX=true

# Client Network Config
VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org